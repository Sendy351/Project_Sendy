  "item": [
    {
      "name": "1. Autentikasi & Pengguna",
      "item": [
        {
          "name": "Register Pengguna Baru",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Siti Rahma\",\n  \"email\": \"siti@gmail.com\",\n  \"kata_sandi\": \"password123\",\n  \"telepon\": \"085678901234\",\n  \"alamat\": \"Jl. Dipati Ukur No. 20, Bandung\",\n  \"peran\": \"pengguna\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Pengguna",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@gmail.com\",\n  \"kata_sandi\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profil Pengguna",
